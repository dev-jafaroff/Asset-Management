# Local PostgreSQL (docker compose up -d)
DATABASE_URL="postgresql://asset:asset@localhost:5433/asset_management?schema=public"

# Sign-in (Better Auth + Microsoft Entra ID)
# Session cookie key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Entra app registration "Asset Management": Application (client) ID and a client secret value
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Tenants whose people may sign in (EIG, Waverity), comma-separated
AUTH_ALLOWED_TENANT_IDS=""

# User sync: the Entra group that holds the employees, per tenant, as
# <tenant id>=<group id> pairs (EIG, Waverity), comma-separated
USER_SYNC_GROUPS=""

# Intune sync: the tenants whose Intune devices are read (EIG, Waverity),
# comma-separated; each needs admin consent for DeviceManagementManagedDevices.Read.All
INTUNE_TENANT_IDS=""

# Scheduled jobs (user sync, Intune sync): the scheduler sends it as
# "Authorization: Bearer <CRON_SECRET>". Same command as BETTER_AUTH_SECRET.
CRON_SECRET=""
