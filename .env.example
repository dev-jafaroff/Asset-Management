# Local PostgreSQL (docker compose up -d)
DATABASE_URL="postgresql://asset:asset@localhost:5433/asset_management?schema=public"

# Sign-in (Better Auth + Microsoft Entra ID)
# Session cookie key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Entra app registration "Asset Management": Application (client) ID and a client secret value
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Tenants whose people may sign in (EIG, Waverity), comma-separated
AUTH_ALLOWED_TENANT_IDS=""
