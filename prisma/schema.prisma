generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum AssetType {
  PC
  MONITOR
  PRINTER
  PHONE
  VM
  ACCESS_POINT
  CAMERA
  // One-off devices (e.g. a card reader); the model's category says what it is.
  OTHER
}

enum AssetSource {
  MANUAL
  INTUNE
  SNIPEIT
}

enum StatusType {
  DEPLOYABLE
  PENDING
  UNDEPLOYABLE
  ARCHIVED
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum SyncKind {
  // People from Entra ID (both tenants).
  USERS
  // Devices from Intune.
  INTUNE
}

enum AssetEventType {
  CREATED
  UPDATED
  CHECKOUT
  CHECKIN
  SYNC
  IMPORTED
}

// ─── Lookup tables ───────────────────────────────────────────────────────────

model Category {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  // Icon of an accessory category, a key of the registry in
  // components/assets/asset-icons.tsx, e.g. "keyboard".
  icon        String?
  models      AssetModel[]
  accessories Accessory[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model AssetModel {
  id           Int      @id @default(autoincrement())
  name         String
  manufacturer String?
  categoryId   Int
  category     Category @relation(fields: [categoryId], references: [id])
  assets       Asset[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([manufacturer, name])
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  assets    Asset[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Location {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  assets    Asset[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StatusLabel {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  type      StatusType
  color     String
  assets    Asset[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id            Int     @id @default(autoincrement())
  entraObjectId String  @unique
  // The Entra tenant entraObjectId belongs to. Synced Waverity people are
  // guests of the EIG tenant, so it is EIG for them; null for dev users.
  tenantId      String?
  email         String  @unique
  displayName   String
  department    String?
  jobTitle      String?
  role          Role    @default(VIEWER)
  isActive      Boolean @default(true)

  assignedAssets        Asset[]                @relation("AssetAssignedTo")
  accessories           AccessoryAssignment[]  @relation("AccessoryAssignedTo")
  accessoriesAssigned   AccessoryAssignment[]  @relation("AccessoryAssignedBy")
  accessoriesReturned   AccessoryAssignment[]  @relation("AccessoryReturnedBy")
  accessoryStockChanges AccessoryStockChange[]
  eventsPerformed       AssetEvent[]           @relation("EventActor")
  eventsReceived        AssetEvent[]           @relation("EventTargetUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Assets ──────────────────────────────────────────────────────────────────

model Asset {
  id       Int       @id @default(autoincrement())
  type     AssetType
  assetTag String?   @unique
  serial   String?   @unique
  name     String?
  notes    String?

  // Phones
  imei        String? @unique
  phoneNumber String?

  // PCs (from Intune) and VMs (manual)
  operatingSystem          String?
  osVersion                String?
  // The other system of a dual-boot PC, from its second Intune record
  // (e.g. Linux next to Windows).
  secondaryOperatingSystem String?
  secondaryOsVersion       String?

  // VMs
  vmHost String?
  vCpu   Int?
  ramGb  Int?

  purchaseCost Decimal?  @db.Decimal(10, 2)
  purchaseDate DateTime? @db.Date

  source            AssetSource @default(MANUAL)
  // Set by the Intune sync once the serial is found in Intune; the asset is
  // then managed by Intune, whatever its source.
  intuneId          String?     @unique
  // The Intune tenant (EIG or Waverity) the device is enrolled in, where
  // actions on it (e.g. a check-in request) are sent.
  intuneTenantId    String?
  lastIntuneSync    DateTime?
  missingInIntune   Boolean     @default(false)
  // The device's primary user in Intune (their sign-in name), shown as a
  // suggestion: the holder is never changed by the sync.
  intunePrimaryUser String?
  // What the last Intune sync found wrong with this asset (e.g. the Intune
  // device named after its tag has another serial), until a sync finds it
  // fine. Shown in its Intune card.
  intuneSyncProblem String?
  legacySnipeId     Int?        @unique

  statusId     Int
  status       StatusLabel @relation(fields: [statusId], references: [id])
  modelId      Int?
  model        AssetModel? @relation(fields: [modelId], references: [id], onDelete: Restrict)
  companyId    Int?
  company      Company?    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  locationId   Int?
  location     Location?   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  assignedToId Int?
  assignedTo   User?       @relation("AssetAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)

  events AssetEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([statusId])
  @@index([assignedToId])
  @@index([companyId])
}

model AssetEvent {
  id           Int            @id @default(autoincrement())
  assetId      Int
  asset        Asset          @relation(fields: [assetId], references: [id])
  type         AssetEventType
  actorId      Int?
  actor        User?          @relation("EventActor", fields: [actorId], references: [id], onDelete: Restrict)
  targetUserId Int?
  targetUser   User?          @relation("EventTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)
  changes      Json?
  // Free text typed with a checkout or checkin, e.g. "Charger handed over".
  note         String?
  createdAt    DateTime       @default(now())

  @@index([assetId, createdAt])
}

// ─── Accessories ─────────────────────────────────────────────────────────────

model Accessory {
  id            Int                    @id @default(autoincrement())
  name          String                 @unique
  categoryId    Int
  category      Category               @relation(fields: [categoryId], references: [id])
  totalQuantity Int                    @default(0)
  assignments   AccessoryAssignment[]
  stockChanges  AccessoryStockChange[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
}

model AccessoryAssignment {
  id           Int       @id @default(autoincrement())
  accessoryId  Int
  accessory    Accessory @relation(fields: [accessoryId], references: [id])
  userId       Int
  user         User      @relation("AccessoryAssignedTo", fields: [userId], references: [id])
  quantity     Int       @default(1)
  assignedAt   DateTime  @default(now())
  returnedAt   DateTime?
  assignedById Int?
  assignedBy   User?     @relation("AccessoryAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  returnedById Int?
  returnedBy   User?     @relation("AccessoryReturnedBy", fields: [returnedById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([accessoryId, returnedAt])
}

// Every change of an accessory's total quantity, e.g. 30 → 40 when more were
// bought. Assignments and returns are their own history (AccessoryAssignment).
model AccessoryStockChange {
  id           Int       @id @default(autoincrement())
  accessoryId  Int
  accessory    Accessory @relation(fields: [accessoryId], references: [id])
  // Null until sign-in exists (see lib/current-user.ts).
  actorId      Int?
  actor        User?     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  // Null when the accessory was added.
  fromQuantity Int?
  toQuantity   Int
  note         String?
  createdAt    DateTime  @default(now())

  @@index([accessoryId, createdAt])
}

// ─── Sync ────────────────────────────────────────────────────────────────────

// One run of a sync, by the schedule or by "Sync now".
model SyncRun {
  id         Int       @id @default(autoincrement())
  kind       SyncKind
  startedAt  DateTime  @default(now())
  // Null while it runs.
  finishedAt DateTime?
  created    Int       @default(0)
  updated    Int       @default(0)
  // People turned inactive (users) or devices flagged missing (Intune).
  missing    Int       @default(0)
  // What went wrong, e.g. a tenant that has not given admin consent.
  errors     Json?

  @@index([kind, startedAt])
}
